rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Public website can read listings; only the signed-in admin can change them
    match /properties/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Home page ad banners (Admin → Ads / Banners)
    match /banners/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Staff contacts shown on property pages (Admin → Staff Config)
    match /staff/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
